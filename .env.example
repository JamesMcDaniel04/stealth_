# Copy to .env and fill in. The eval + unit tests run without any of these
# (they use a deterministic stub embedder + SQLite + a recorded extraction fixture).
# Keys are only needed for the LIVE embedder and live Claude extraction.

# OpenAI: used for the resolution layer's real embeddings AND Graphiti's embeddings.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Claude): used by Graphiti for entity extraction from free text.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# API auth: when set, the service requires `Authorization: Bearer <token>`.
RECONCILE_API_TOKEN=

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reconcile-dev

# Postgres decision store (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://reconcile:reconcile-dev@localhost:5433/reconcile

# Resolution thresholds (confidence bands)
RECONCILE_AUTO_MERGE_THRESHOLD=0.80
RECONCILE_AUTO_REJECT_THRESHOLD=0.30
