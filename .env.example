# Copy to .env and fill in. The eval + unit tests run without any of these
# (they use a deterministic stub embedder + SQLite). The live demo needs them.

# LLM provider used by Graphiti for extraction (and, if set, by the real embedder).
OPENAI_API_KEY=

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reconcile-dev

# Postgres decision store (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://reconcile:reconcile-dev@localhost:5432/reconcile

# Resolution thresholds (confidence bands)
RECONCILE_AUTO_MERGE_THRESHOLD=0.80
RECONCILE_AUTO_REJECT_THRESHOLD=0.30
